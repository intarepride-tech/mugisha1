# Base URL of the Agri Market Worker API.
# Defaults to the production Worker in src/agri/api.js if this isn't set,
# so this file is optional — copy it to .env only when pointing the app at
# a different deploy (e.g. a local `wrangler dev` or a staging Worker).
VITE_API_BASE=https://mugisha.intarepride.workers.dev